<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>ラダーランキングデモ</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .tab-content { margin-top: 1em; }
    .table td a { cursor: pointer; color: blue; text-decoration: underline; }
  </style>
</head>
<body class="p-3">

<h2>ラダーランキング（デモ）</h2>

<!-- タブ -->
<ul class="nav nav-tabs" id="ladderTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="arabia-tab" data-bs-toggle="tab" data-bs-target="#arabia" type="button">arabia</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="ln-tab" data-bs-toggle="tab" data-bs-target="#LN" type="button">LN</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="michi-tab" data-bs-toggle="tab" data-bs-target="#michi" type="button">michi</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="bakuran-tab" data-bs-toggle="tab" data-bs-target="#bakuran" type="button">bakuran</button>
  </li>
</ul>

<!-- タブコンテンツ -->
<div class="tab-content">
  <div class="tab-pane fade show active" id="arabia">
    <table class="table table-striped">
      <thead><tr><th>#</th><th>名前</th><th>レート</th></tr></thead>
      <tbody>
        <tr><td>1</td><td><a class="player-link">Player A</a></td><td>1600</td></tr>
        <tr><td>2</td><td><a class="player-link">Player B</a></td><td>1550</td></tr>
        <tr><td>3</td><td><a class="player-link">Player C</a></td><td>1500</td></tr>
      </tbody>
    </table>
  </div>
  <div class="tab-pane fade" id="LN">
    <table class="table table-striped">
      <thead><tr><th>#</th><th>名前</th><th>レート</th></tr></thead>
      <tbody>
        <tr><td>1</td><td><a class="player-link">Player D</a></td><td>1580</td></tr>
        <tr><td>2</td><td><a class="player-link">Player E</a></td><td>1540</td></tr>
        <tr><td>3</td><td><a class="player-link">Player F</a></td><td>1490</td></tr>
      </tbody>
    </table>
  </div>
  <div class="tab-pane fade" id="michi">
    <table class="table table-striped">
      <thead><tr><th>#</th><th>名前</th><th>レート</th></tr></thead>
      <tbody>
        <tr><td>1</td><td><a class="player-link">Player G</a></td><td>1610</td></tr>
        <tr><td>2</td><td><a class="player-link">Player H</a></td><td>1570</td></tr>
        <tr><td>3</td><td><a class="player-link">Player I</a></td><td>1520</td></tr>
      </tbody>
    </table>
  </div>
  <div class="tab-pane fade" id="bakuran">
    <table class="table table-striped">
      <thead><tr><th>#</th><th>名前</th><th>レート</th></tr></thead>
      <tbody>
        <tr><td>1</td><td><a class="player-link">Player J</a></td><td>1620</td></tr>
        <tr><td>2</td><td><a class="player-link">Player K</a></td><td>1590</td></tr>
        <tr><td>3</td><td><a class="player-link">Player L</a></td><td>1530</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- モーダル -->
<div class="modal fade" id="playerModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">プレイヤー情報</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>ここにプレイヤーの詳細が入ります（仮テキスト）。</p>
      </div>
    </div>
  </div>
</div>

<!-- スクリプト -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  $(document).on("click", ".player-link", function () {
    let name = $(this).text();
    $(".modal-title").text(name + " の詳細");
    $(".modal-body").html(`<p>${name} の情報はここに表示されます（仮）。</p>`);
    new bootstrap.Modal(document.getElementById("playerModal")).show();
  });
</script>

</body>
</html>

